# Instagram sync (npm run sync-instagram) — three sources, checked in this order:

# Option A: official data export — works with PERSONAL accounts, full history.
# Instagram app/site: Accounts Center -> Your information and permissions ->
# Download your information -> Instagram only -> JSON format, high media
# quality, all time. Unzip, then run:
#   npm run sync-instagram -- --from-export <path-to-unzipped-folder>
# (No env var needed.)

# Option B: Behold JSON feed (behold.so). Requires a Business/Creator account;
# free plan serves the 6 most recent posts.
BEHOLD_FEED_URL=

# Option C: Instagram API with Instagram Login (Meta developer app; requires a
# Business/Creator account). Prefer putting the long-lived token in a
# .instagram-token file (gitignored) — the sync script auto-refreshes it there.
IG_ACCESS_TOKEN=
