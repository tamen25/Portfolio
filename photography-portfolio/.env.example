# Instagram sync (npm run sync-instagram) — configure ONE of the two sources:

# Option A: Behold JSON feed (behold.so → connect Instagram → add JSON feed).
# Free plan serves the 6 most recent posts; paid plans serve more.
BEHOLD_FEED_URL=

# Option B: Instagram API with Instagram Login (Meta developer app; full history).
# Prefer putting the long-lived token in a .instagram-token file (gitignored) —
# the sync script auto-refreshes it there. This env var also works but is static.
IG_ACCESS_TOKEN=
